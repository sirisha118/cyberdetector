# /etc/systemd/system/cybershield.service
# Run ONE gunicorn worker group with the scheduler, or set ENABLE_SCHEDULER=false and use `flask scan-now` from cron.
[Unit]
Description=CyberShield e-mail threat protection
After=network.target postgresql.service

[Service]
User=cybershield
WorkingDirectory=/opt/cybershield
EnvironmentFile=/opt/cybershield/.env
Environment=FLASK_CONFIG=production
ExecStart=/opt/cybershield/venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8000 wsgi:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
