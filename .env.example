# Copy to .env and edit
FLASK_CONFIG=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg2://cybershield:cybershield@localhost:5432/cybershield
ALLOW_REGISTRATION=true
ENABLE_SCHEDULER=true
SCHEDULER_TICK_SECONDS=60

# Optional URL reputation providers (leave blank to disable)
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
URL_DNS_CHECK=true
DNSBL_ENABLED=true
URL_FOLLOW_REDIRECTS=true
URL_FOLLOW_TIMEOUT=5

# Gmail OAuth2 (leave blank to use IMAP app-password instead)
# Create credentials at https://console.cloud.google.com/
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/oauth/gmail/callback
GMAIL_POLL_LIMIT=50

# Optional fallback SMTP for security alert e-mails (per-mailbox SMTP is used first)
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_FROM=cybershield@localhost
